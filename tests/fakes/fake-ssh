#!/usr/bin/env python3
"""Fake `ssh` for tests: runs the remote command locally (the "host" is this machine).

Options are parsed like OpenSSH's; `-L <local socket>:<remote socket>` becomes a symlink (connecting to a symlink of
a Unix socket reaches the socket), `-R` is recorded only. Calls are logged to $FAKE_AGENT_STATE/ssh_calls.log.

Like OpenSSH: `-G` prints the resolved configuration, `-O <cmd>` talks to a (non-existent) master and succeeds, `-W`
(a bastion hop of a ProxyCommand) only connects, and `-o ProxyCommand=…` is run first (with %h %p %r %% expanded) —
when it fails, so does the connection. Destinations whose host part starts with these words fail with exit 255:
unreachable (connection refused), authfail (permission denied), badkey (host key verification failed), nodns
(cannot resolve). A destination in $FAKE_AGENT_STATE/ssh_down (one per line) is unreachable too. When
$FAKE_AGENT_STATE/ssh_no_net exists, the "host" has no internet: its curl and wget fail (tests/fakes/nonet). When $FAKE_AGENT_STATE/ssh_clean_env exists, the remote command gets
only what sshd would give it (PATH, HOME, USER, …; plus FAKE_* and CODEX_HOME for the fakes), not this process's
environment.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("FAKE_AGENT_STATE", "/tmp/fake-agent-state"))
STATE.mkdir(parents=True, exist_ok=True)
WITH_VALUE = set("bcDEeFIiJLlmOoPpQRSWw")
FAILURES = {
    "unreachable": "ssh: connect to host {h} port {p}: Connection refused",
    "authfail": "{u}@{h}: Permission denied (publickey).",
    "badkey": "No ED25519 host key is known for {h} and you have requested strict checking.\nHost key verification failed.",
    "nodns": "ssh: Could not resolve hostname {h}: Name or service not known",
}


def expand(cmd, host, port, user):
    out, i = [], 0
    while i < len(cmd):
        c = cmd[i]
        if c == "%" and i + 1 < len(cmd):
            n = cmd[i + 1]
            out.append({"%": "%", "h": host, "p": str(port), "r": user, "n": host}.get(n, "%" + n))
            i += 2
            continue
        out.append(c)
        i += 1
    return "".join(out)


def main(argv):
    with (STATE / "ssh_calls.log").open("a") as fh:
        fh.write(json.dumps(argv) + "\n")
    i = 0
    forwards = []
    opts = {}
    flags = {}
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a.startswith("-") and len(a) >= 2:
            letter = a[1]
            if letter in WITH_VALUE:
                val = a[2:] if len(a) > 2 else argv[i + 1]
                if letter == "L":
                    forwards.append(val)
                elif letter == "o":
                    k, _, v = val.partition("=")
                    opts.setdefault(k.lower(), v)
                else:
                    flags[letter] = val
                i += 1 if len(a) > 2 else 2
                continue
            flags[letter] = True
            i += 1
            continue
        break
    dest = argv[i]
    cmd = " ".join(argv[i + 1:])
    user, _, host = dest.rpartition("@")
    user = flags.get("l") or user or os.environ.get("USER", "me")
    port = int(flags.get("p") or 22)
    if flags.get("G"):
        print(f"user {user}\nhostname {host}\nport {port}")
        for k, v in opts.items():
            print(f"{k} {v}")
        return 0
    if "O" in flags:
        return 0
    down = (STATE / "ssh_down").read_text().split() if (STATE / "ssh_down").exists() else []
    for word, msg in FAILURES.items():
        if host.startswith(word) or (word == "unreachable" and (dest in down or host in down)):
            print(msg.format(h=host, p=port, u=user), file=sys.stderr)
            return 255
    pc = opts.get("proxycommand")
    if pc and pc.lower() != "none":
        r = subprocess.run(["sh", "-c", expand(pc, host, port, user)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE, text=True)
        if r.returncode != 0:
            sys.stderr.write(r.stderr)
            print("kex_exchange_identification: Connection closed by remote host", file=sys.stderr)
            return 255
    if "W" in flags:
        return 0
    for fw in forwards:
        local, remote = fw.split(":", 1)
        if os.path.lexists(local):
            os.unlink(local)
        if not cmd:
            continue
        # the remote socket appears once the remote command started listening: link it (in the background)
        if os.fork() == 0:
            for _ in range(400):
                if os.path.exists(remote):
                    try:
                        os.symlink(remote, local)
                    except FileExistsError:
                        pass
                    break
                time.sleep(0.05)
            os._exit(0)
    if not cmd:
        return 0
    if (STATE / "ssh_clean_env").exists():
        keep = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LC_ALL", "TERM", "TMPDIR", "TMUX_TMPDIR", "CODEX_HOME")
        for k in list(os.environ):
            if k not in keep and not k.startswith("FAKE_"):
                del os.environ[k]
    if (STATE / "ssh_no_net").exists():
        os.environ["PATH"] = str(Path(__file__).resolve().parent / "nonet") + os.pathsep + os.environ.get("PATH", "")
        os.environ["FAKE_NO_NET"] = "1"
    os.execvp("sh", ["sh", "-c", cmd])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
