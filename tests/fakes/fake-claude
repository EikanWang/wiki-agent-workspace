#!/usr/bin/env python3
"""Fake `claude` for tests: `claude -p --resume <id> ... <text>` appends a user and an assistant entry to the
session's transcript in $CLAUDE_CONFIG_DIR/projects/*/<id>.jsonl."""
import json
import os
import sys
from pathlib import Path

argv = sys.argv[1:]
root = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude"))) / "projects"
if "--resume" not in argv or "-p" not in argv:
    print("fake claude: interactive mode not supported", file=sys.stderr)
    sys.exit(2)
sid = argv[argv.index("--resume") + 1]
text = argv[-1]
hits = list(root.glob(f"*/{sid}.jsonl"))
if not hits:
    print(f"No conversation found with session ID: {sid}", file=sys.stderr)
    sys.exit(1)
with hits[0].open("a") as fh:
    fh.write(json.dumps({"type": "user", "cwd": os.getcwd(), "timestamp": "2026-11-11T00:00:00Z", "message": {"role": "user", "content": text}}) + "\n")
    fh.write(json.dumps({"type": "assistant", "cwd": os.getcwd(), "timestamp": "2026-11-11T00:00:01Z",
                         "message": {"role": "assistant", "model": "fake", "stop_reason": "end_turn", "content": [{"type": "text", "text": f"claude echo: {text}"}]}}) + "\n")
print(f"claude echo: {text}")
