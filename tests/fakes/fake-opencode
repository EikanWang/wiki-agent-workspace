#!/usr/bin/env python3
"""Controllable fake `opencode` executable for tests (no credentials needed).

State dir: $FAKE_AGENT_STATE (default /tmp/fake-agent-state). Prompt directives:
  [[fail:msg]]  [[auth]]  [[busy]]  [[sleep:N]]  [[edit:rel:::old:::new]]  [[write:rel:::content]]
  [[permission]]  [[noid]]  — otherwise replies "echo: <user message>".
"""
import json
import os
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("FAKE_AGENT_STATE", "/tmp/fake-agent-state"))
STATE.mkdir(parents=True, exist_ok=True)
SESS = STATE / "opencode_sessions.json"


def load():
    return json.loads(SESS.read_text()) if SESS.exists() else []


def save(x):
    SESS.write_text(json.dumps(x))


def log_call(argv):
    with (STATE / "opencode_calls.log").open("a") as fh:
        fh.write(json.dumps(argv) + "\n")


def main(argv):
    log_call(argv)
    if argv[:1] == ["--version"]:
        print("0.0.0-fake")
        return 0
    if argv[:1] == ["models"]:
        print("fake/alpha\nfake/beta\nother/gamma")
        return 0
    if argv[:2] == ["session", "list"]:
        print(json.dumps([{"id": s["id"], "title": s["title"], "updated": s["updated"], "created": s["updated"], "directory": s["directory"]} for s in load()]))
        return 0
    if argv[:1] != ["run"]:
        print("unknown command", file=sys.stderr)
        return 2
    args = argv[1:]
    session = None
    title = None
    directory = os.getcwd()
    i = 0
    rest = []
    while i < len(args):
        a = args[i]
        if a in ("--format", "--agent"):
            i += 2
            continue
        if a in ("--model", "--variant"):
            (STATE / f"opencode_last_{a[2:]}").write_text(args[i + 1])
            i += 2
            continue
        if a == "--session":
            session = args[i + 1]
            i += 2
            continue
        if a == "--title":
            title = args[i + 1]
            i += 2
            continue
        if a == "--dir":
            directory = args[i + 1]
            i += 2
            continue
        if a == "--":  # end of options: everything after it is the message
            rest.extend(args[i + 1:])
            break
        if a.startswith("--file=") or a in ("--file", "-f"):
            # like the real CLI (yargs array option): it takes this value AND every following argument up to the
            # next option or "--" — a prompt placed right after it would be read as a file name
            files = [a.split("=", 1)[1]] if "=" in a else []
            i += 1
            while i < len(args) and not args[i].startswith("-"):
                files.append(args[i])
                i += 1
            for f in files:
                if not os.path.exists(f):
                    sys.stderr.write(f"Error: File not found: {f}\n")
                    return 1
            with (STATE / "opencode_last_files").open("a") as fh:
                fh.write("".join(f + "\n" for f in files))
            continue
        rest.append(a)
        i += 1
    prompt = " ".join(rest)
    user_msg = prompt.split("User message:", 1)[1].split("\n\nInstructions:", 1)[0].strip() if "User message:" in prompt else prompt

    def emit(obj):
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()

    if "[[auth]]" in user_msg:
        print("Error: 401 Unauthorized - please run `opencode auth login`", file=sys.stderr)
        return 1
    if "[[busy]]" in user_msg:
        print("Error: session is busy (another client is using it)", file=sys.stderr)
        return 1
    if "[[noid]]" in user_msg:
        return 1
    sessions = load()
    if session is not None:
        if not any(s["id"] == session for s in sessions):
            print(f"Error: session not found: {session}", file=sys.stderr)
            return 1
    else:
        session = f"ses_fake{len(sessions) + 1:04d}"
        sessions.append({"id": session, "title": title or prompt[:40], "updated": int(time.time() * 1000), "directory": directory})
        save(sessions)
    if prompt.startswith("You are receiving a REVIEW"):
        # Triage: comments containing "please change X to Y" are addressed by editing; questions get a reply; "[[skip]]" is skipped.
        import re as _re
        items = []
        for m in _re.finditer(r"--- Comment \d+ \(id ([0-9a-f-]+)\) on (\S+), .*?\nReviewer says: (.*?)(?=\n(?:Hunk:|--- Comment |After making)|\Z)", prompt, _re.S):
            cid, path, says = m.group(1), m.group(2), m.group(3).strip()
            locked = f"LOCKED by the user and must NOT be modified" in prompt and path in prompt.split("must NOT be modified (use `reply` instead of `address`): ", 1)[-1].split("\n", 1)[0]
            ch = _re.search(r"please change (.+?) to (.+?)[.]?$", says, _re.S)
            if ch and not locked:
                p_ = Path(directory) / path
                p_.write_text(p_.read_text().replace(ch.group(1).strip(), ch.group(2).strip()))
                items.append({"id": cid, "decision": "address", "response": f"Changed '{ch.group(1).strip()}' to '{ch.group(2).strip()}'."})
            elif "[[skip]]" in says:
                items.append({"id": cid, "decision": "skip", "response": "Already covered."})
            else:
                items.append({"id": cid, "decision": "reply", "response": ("Cannot edit: the file is locked. " if locked else "") + f"Answer to: {says[:60]}"})
        text = "Reviewed all comments.\n\n```json\n" + json.dumps({"comments": items, "summary": f"Handled {len(items)} comments."}) + "\n```"
        emit({"type": "step_start", "sessionID": session, "part": {"type": "step-start"}})
        emit({"type": "text", "sessionID": session, "part": {"id": "prt_1", "type": "text", "text": text}})
        emit({"type": "step_finish", "sessionID": session, "part": {"type": "step-finish", "reason": "stop"}})
        return 0
    if "fenced block tagged waw-review" in prompt:
        # an agent PR review: comment on the first added line of the diff in the prompt, plus a line outside the diff
        # (becomes a file comment) and a file that is not in the PR (dropped)
        import re as _re
        path, line = None, None
        for ln in prompt.split("\n"):
            h = _re.match(r"### (\S+) \(", ln)
            if h and path is None:
                path = h.group(1)
            m = _re.match(r"^\s*(\d*)\s+(\d+) \|\+", ln)
            if m and path and line is None:
                line = int(m.group(2))
        items = [{"path": path, "side": "RIGHT", "line": line, "body": "Agent: is this guard needed?"},
                 {"path": path, "side": "RIGHT", "line": 9999, "body": "Agent: consider a test."},
                 {"path": "not/in/pr.cpp", "side": "RIGHT", "line": 1, "body": "x"}]
        text = "Overall the change looks fine.\n\n```waw-review\n" + json.dumps(items) + "\n```"
        emit({"type": "step_start", "sessionID": session, "part": {"type": "step-start"}})
        emit({"type": "text", "sessionID": session, "part": {"id": "prt_1", "type": "text", "text": text}})
        emit({"type": "step_finish", "sessionID": session, "part": {"type": "step-finish", "reason": "stop"}})
        return 0
    emit({"type": "step_start", "sessionID": session, "part": {"type": "step-start"}})
    if "[[permission]]" in user_msg:
        emit({"type": "permission", "sessionID": session, "id": "per_fake1", "title": "fake wants to run `rm`"})
    if "[[sleep:" in user_msg:
        n = float(user_msg.split("[[sleep:", 1)[1].split("]]", 1)[0])
        emit({"type": "text", "sessionID": session, "part": {"id": "prt_0", "type": "text", "text": "working..."}})
        time.sleep(n)
    if "[[fail:" in user_msg:
        msg = user_msg.split("[[fail:", 1)[1].split("]]", 1)[0]
        emit({"type": "error", "sessionID": session, "error": {"name": "UnknownError", "data": {"message": msg}}})
        return 1
    text = f"echo: {user_msg}"
    if prompt.startswith("Write a Git commit message"):
        files = prompt.split("Files (", 1)[1].split("\n", 1)[0].split("): ", 1)[1] if "Files (" in prompt else "files"
        text = f"Update {files.split(',')[0].strip()}\n\n- summarise the diff that was provided\n- fake draft for tests"
    if "[[edit:" in user_msg:
        spec = user_msg.split("[[edit:", 1)[1].split("]]", 1)[0]
        rel, old, new = spec.split(":::")
        p = Path(directory) / rel
        p.write_text(p.read_text().replace(old, new))
        emit({"type": "tool", "sessionID": session, "part": {"type": "tool", "tool": "edit", "state": {"status": "completed", "title": rel}}})
        text = f"edited {rel}"
    if "[[write:" in user_msg:
        spec = user_msg.split("[[write:", 1)[1].split("]]", 1)[0]
        rel, content = spec.split(":::", 1)
        p = Path(directory) / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content.replace("\\n", "\n"))
        text = f"wrote {rel}"
    if "distill this whole conversation into a wiki page at `" in prompt:
        # a folder chat distilled into a page: the page holds the conversation's user questions
        import re as _re
        rel = prompt.split("distill this whole conversation into a wiki page at `", 1)[1].split("`", 1)[0]
        asked = _re.findall(r"^\[user\] (.*)$", prompt, _re.M)
        p = Path(directory) / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text("# Distilled\n\n" + "".join(f"- {q}\n" for q in asked))
        text = f"Wrote {rel} from {len(asked)} question(s)."
    emit({"type": "text", "sessionID": session, "part": {"id": "prt_1", "type": "text", "text": text}})
    emit({"type": "step_finish", "sessionID": session, "part": {"type": "step-finish", "reason": "stop"}})
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
